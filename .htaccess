DirectoryIndex index.html

RewriteEngine On
RewriteRule ^$ /index.html [L,R=301]

ErrorDocument 404 /index.html

<FilesMatch "^\.(env|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>